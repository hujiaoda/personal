# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 超时与重试（秒/次数），后续 config.py 读取
PDA_HTTP_CONNECT_TIMEOUT=10
PDA_HTTP_READ_TIMEOUT=30
PDA_MAX_RETRIES=2
PDA_MAX_TOOL_ROUNDS=6
PDA_MAX_SQL_FIX_ROUNDS=3

# M2 记忆系统：策略 none/window/window_summary/full，M5 评测按此重放
PDA_MEMORY_STRATEGY=full
PDA_MEMORY_WINDOW_SIZE=20
PDA_MEMORY_WINDOW_TOKENS=8000
PDA_MEMORY_TOP_K=8
PDA_MEMORY_DECAY_LAMBDA=0.05
PDA_MEMORY_DB_PATH=data/pda.db

# M3 智能问数：用户库路径、SQL 执行超时（秒）、返回行数上限、schema 样例行数
PDA_SQL_USER_DB_PATH=data/user_tables.db
PDA_SQL_QUERY_TIMEOUT=5
PDA_SQL_ROW_LIMIT=100
PDA_SQL_SCHEMA_SAMPLE_SIZE=3
